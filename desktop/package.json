{
  "name": "abbey-desktop",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:models": "bun test tests",
    "preview": "vite preview",
    "codegen": "cargo run --manifest-path codegen/Cargo.toml --quiet --locked --",
    "codegen:check": "cargo run --manifest-path codegen/Cargo.toml --quiet --locked -- --check",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "tauri": "tauri",
    "smoke:routes:macos": "./scripts/prove-routes-macos.sh",
    "release:macos": "./scripts/release-macos.sh",
    "prove:packaged": "./scripts/prove-packaged-macos.sh",
    "prove:menu:macos": "./scripts/prove-menu-icon-macos.sh",
    "updater:feed": "./scripts/assemble-update-feed.sh",
    "updater:keygen": "./scripts/updater-keygen.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
