{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abbey",
  "version": "2.6.0",
  "identifier": "com.donaldfilimon.abbey",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Abbey",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 540,
        "center": true,
        "titleBarStyle": "Transparent",
        "transparent": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.productivity",
    "copyright": "© 2026 Donald Filimon",
    "publisher": "Donald Filimon",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/master.png"
    ],
    "shortDescription": "Abbey desktop client",
    "longDescription": "Read-only desktop client for Abbey's shared application core: runtime status, build stamp, capabilities, and the canonical capability ledger.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": "./entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RUMyRTJBODI0QkY0RjAKUldUdzlFdUNLaTdzTnVDR2pKbVRuaFgyb2VlbEFOOTJFVWlvM1NUd3h2YnVlem1OQjN1Sm5zY1oK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/donaldfilimon/abbey/releases/latest/download/latest.json"
      ]
    }
  }
}
